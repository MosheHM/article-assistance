.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.log

# Chrome extension packaging
*.crx
*.pem
*.zip

# Node modules (if using build tools)
node_modules/
package-lock.json

# Build output (if using build tools)
dist/
build/

# Environment files
.env
.env.local
